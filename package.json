{
  "name": "steiger-vscode",
  "displayName": "steiger",
  "description": "steiger language server",
  "version": "0.1.0",
  "publisher": "feature-sliced",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/feature-sliced/steiger-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/feature-sliced/steiger-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/feature-sliced/steiger-vscode/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "linter",
    "architecture",
    "feature-sliced",
    "fsd",
    "vue",
    "svelte"
  ],
  "markdown": "github",
  "galleryBanner": {
    "color": "#0e1117",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "workspaceContains:**/steiger.config.{ts,js,mjs,cjs}"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Steiger",
      "properties": {
        "steiger.languageServerPath": {
          "scope": "resource",
          "type": "string",
          "default": "",
          "description": "Path to a custom language server module used instead of the bundled one. Relative paths are resolved against the workspace root. Leave empty to use the bundled server."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js && code --extensionDevelopmentPath=\"$PWD\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "vscode-languageclient": "^10.1.0"
  }
}
